{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "RAILPACK",
        "buildCommand": "pnpm turbo run build --filter=front-react..."
    },
    "deploy": {
        "startCommand": "npx serve -s apps/front-react/dist -l $PORT",
        "restartPolicyType": "ON_FAILURE"
    }
}
