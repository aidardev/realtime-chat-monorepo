{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "RAILPACK",
        "buildCommand": "pnpm install && pnpm --filter @realtime-chat/database run build && pnpm --filter backend run build"
    },
    "deploy": {
        "preDeployCommand": "pnpm --filter @realtime-chat/database db:deploy",
        "startCommand": "node apps/backend/dist/src/index.js",
        "restartPolicyType": "ON_FAILURE"
    }
}
