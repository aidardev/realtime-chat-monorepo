{
    "$schema": "https://railway.com/railway.schema.json",
    "build": {
        "builder": "RAILPACK",
        "buildCommand": "pnpm turbo run build --filter=@realtime-chat/database --filter=backend"
    },
    "deploy": {
        "preDeployCommand": "pnpm --filter @realtime-chat/database db:deploy",
        "startCommand": "node apps/backend/dist/index.js",
        "restartPolicyType": "ON_FAILURE"
    }
}
